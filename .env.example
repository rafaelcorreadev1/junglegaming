# Local example values only. Copy to .env to override the Docker Compose defaults.

POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering
POSTGRES_DB=wagering
POSTGRES_PORT=5432

APP_PORT=8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=20s

# Used when running the app outside Docker (go run ./cmd/app).
HTTP_ADDR=:8080
DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering?sslmode=disable

# Enables the tests that need a real PostgreSQL (skipped when unset).
TEST_DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering?sslmode=disable
